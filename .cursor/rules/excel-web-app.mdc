## 🔧 功能模块标准

### 📤 文件上传处理模式
```python
def handle_file_upload_standard():
    """📤 标准文件上传处理流程"""
    try:
        # 1️⃣ 验证文件是否上传
        required_files = ['file1', 'file2', 'file3']
        uploaded_files = {}
        
        for file_key in required_files:
            if file_key not in request.files:
                flash(f'❌ 请选择{file_requirements[file_key]["name"]}文件', 'error')
                return redirect(url_for('index'))
            
            file = request.files[file_key]
            if file.filename == '':
                flash(f'❌ 请选择{file_requirements[file_key]["name"]}文件', 'error')
                return redirect(url_for('index'))
            
            if not allowed_file(file.filename):
                flash(f'❌ {file_requirements[file_key]["name"]}文件格式不支持', 'error')
                return redirect(url_for('index'))
            
            # 2️⃣ 保存文件
            filename = secure_filename(file.filename)
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            safe_filename = f"{timestamp}_{filename}"
            file_path = os.path.join(app.config['UPLOAD_FOLDER'], safe_filename)
            file.save(file_path)
            uploaded_files[file_key] = file_path
        
        # 3️⃣ 数据处理
        result = process_data_analysis(**uploaded_files)
        
        # 4️⃣ 清理临时文件
        for file_path in uploaded_files.values():
            safe_remove_file(file_path)
        
        # 5️⃣ 返回结果
        return render_template('results.html', 
                             result_files=result['files'],
                             summary=result['summary'])
    
    except Exception as e:
        logging.error(f"❌ 处理过程中出现错误: {str(e)}")
        flash(f'❌ 处理失败: {str(e)}', 'error')
        return redirect(url_for('index'))
```

### 🔍 数据验证标准模式
```python
def validate_excel_data_standard(df, file_name, requirements):
    """🔍 标准Excel数据验证流程"""
    
    # 1️⃣ 基础验证
    if df.empty:
        raise ValueError(f"❌ {file_name}为空文件")
    
    # 2️⃣ 列名验证
    ExcelDataProcessor.validate_required_columns(
        df, requirements['required_fields'], file_name)
    
    # 3️⃣ 数据类型验证
    for field, dtype in requirements.get('field_types', {}).items():
        if field in df.columns:
            try:
                if dtype == 'datetime':
                    pd.to_datetime(df[field])
                elif dtype == 'numeric':
                    pd.to_numeric(df[field])
            except:
                raise ValueError(f"❌ {file_name}的{field}列数据格式错误")
    
    # 4️⃣ 业务逻辑验证
    custom_validations = requirements.get('custom_validations', [])
    for validation in custom_validations:
        validation(df, file_name)
    
    logging.info(f"✅ {file_name}数据验证通过")
    return True
```

## 🚀 最佳实践

### 🎯 错误处理标准
```python
# 🛡️ 统一错误处理装饰器
def handle_errors(func):
    """🛡️ 统一错误处理装饰器"""
    def wrapper(*args, **kwargs):
        try:
            return func(*args, **kwargs)
        except ValueError as e:
            logging.error(f"❌ 参数错误: {str(e)}")
            flash(f'❌ 数据验证失败: {str(e)}', 'error')
        except FileNotFoundError as e:
            logging.error(f"❌ 文件未找到: {str(e)}")
            flash('❌ 文件处理失败，请检查文件是否存在', 'error')
        except Exception as e:
            logging.error(f"❌ 系统错误: {str(e)}")
            flash(f'❌ 系统错误: {str(e)}', 'error')
        
        return redirect(url_for('index'))
    return wrapper
```

### 📝 日志记录标准
```python
def setup_logging_standard():
    """📝 标准日志配置"""
    try:
        # 兼容EXE环境的日志目录设置
        if hasattr(sys, '_MEIPASS'):
            exe_dir = os.path.dirname(sys.executable)
            log_dir = os.path.join(exe_dir, 'logs')
        else:
            project_root = os.path.dirname(os.path.dirname(os.path.dirname(__file__)))
            log_dir = os.path.join(project_root, 'output', 'logs')
        
        os.makedirs(log_dir, exist_ok=True)
        log_file = os.path.join(log_dir, 'app.log')
        
        logging.basicConfig(
            level=logging.DEBUG,
            format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
            handlers=[
                logging.StreamHandler(sys.stdout),
                logging.FileHandler(log_file, encoding='utf-8')
            ]
        )
        logging.info(f"📝 日志文件路径: {log_file}")
    except Exception as e:
        logging.basicConfig(level=logging.DEBUG,
                          format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
                          handlers=[logging.StreamHandler(sys.stdout)])
        logging.warning(f"⚠️ 无法创建日志文件: {str(e)}")
